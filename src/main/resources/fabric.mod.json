{
    "schemaVersion": 1,
    "id": "endchants",
    "version": "${version}",
    "name": "Endchants",
    "description": "50 new enchantments from Minecraft Dungeons and my own ideas",
    "authors": ["Enderfarmer"],
    "contact": {
        "sources": "https://github.com/Enderfarmer/endchants"
    },
    "license": "MIT",
    "icon": "assets/endchants/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.endchants.Endchants"],
        "client": ["com.endchants.client.EndchantsClient"],
        "fabric-datagen": ["com.endchants.datagen.ModDataGenerator"]
    },
    "mixins": [
        "endchants.mixins.json",
        {
            "config": "endchants.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    }
}
